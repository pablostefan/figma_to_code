{
  "name": "figma2dart-plugin",
  "private": true,
  "version": "0.1.0",
  "description": "Exporta componentes, telas e fluxos do Figma no formato IR v1 do figma2dart.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/ui",
    "schema": "ts-json-schema-generator --path src/extractor/ir.ts --type IR --tsconfig tsconfig.json --no-top-ref -o schema/ir.v1.schema.json",
    "test": "npm run schema && node scripts/test.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run validate -- examples/*.json",
    "validate": "node scripts/validate.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.109.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.25.0",
    "ts-json-schema-generator": "^2.3.0",
    "typescript": "^5.6.0"
  }
}
