{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "matcher": "edit|create|apply_patch|str_replace_editor",
        "bash": "bash \"${PLUGIN_ROOT}/com.github.copilot/hooks/figma2dart.sh\" pre",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "matcher": "edit|create|apply_patch|str_replace_editor",
        "bash": "bash \"${PLUGIN_ROOT}/com.github.copilot/hooks/figma2dart.sh\" post",
        "timeoutSec": 120
      }
    ]
  }
}
